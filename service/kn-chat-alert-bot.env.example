BOT_API_BASE=https://bot.kn.chat
BOT_TOKEN=<your-kn-chat-bot-token>
REPORT_CHAT_ID=<data-platform-department-group-id>

# Nightingale 只读 API：日报只查询下面两个业务组的历史告警，不读取群消息。
N9E_API_BASE=https://bigdata-alert.kuainiu.io
N9E_TOKEN=<your-nightingale-read-only-api-token>
N9E_INFRASTRUCTURE_GROUP_ID=<基础设施业务组-id>
N9E_APPLICATION_GROUP_ID=<应用组件业务组-id>
N9E_REQUEST_TIMEOUT_MS=15000
N9E_PAGE_SIZE=100
N9E_MAX_PAGES=100

REPORT_TIMEZONE=Asia/Shanghai
REPORT_HOUR=19
REPORT_MINUTE=0
REPORT_TOP_N=3
# 仅保存“正式日报是否已发送”的幂等记录；手动快报不写入该状态。
N9E_REPORT_STATE_FILE=/var/lib/kn-chat-alert-bot/n9e-report-state.json
N9E_REPORT_STATE_RETENTION_DAYS=30
