BOT_API_BASE=https://bot.kn.chat
BOT_TOKEN=<your-kn-chat-bot-token>
INFRASTRUCTURE_CHAT_ID=<infrastructure-alert-group-id>
APPLICATION_CHAT_ID=<application-alert-group-id>
REPORT_CHAT_ID=<data-platform-department-group-id>
REPORT_TIMEZONE=Asia/Shanghai
REPORT_HOUR=19
REPORT_MINUTE=0
REPORT_TOP_N=3
# 统计截止点仍为 19:00；日报在截止后等待 2 分钟再发送，以便长轮询消息落盘。
REPORT_GRACE_MINUTES=2
# 已发送日报的原始事件仍保留，方便用 npm run report -- --date YYYY-MM-DD 重算。
REPORT_RETENTION_DAYS=7
OFFSET_FILE=/Users/iris.y.ran/告警机器人/data/offset.json
ALERT_STATE_FILE=/Users/iris.y.ran/告警机器人/data/alert-state.json
POLL_TIMEOUT=20
POLL_LIMIT=20
RETRY_DELAY_MS=3000
REPORT_CHECK_INTERVAL_MS=15000
